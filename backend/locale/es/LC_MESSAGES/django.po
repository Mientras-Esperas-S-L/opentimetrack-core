msgid "nothing: the salary already accounts for it"
msgstr ""

#: apps/tenants/rules.py:360
msgid ""
"Art. 36.2 ET leaves it to the collective agreement. Empty means nothing is "
"tracked, because there would be no figure to track it with."
msgstr ""

#: apps/tenants/rules.py:366
msgid "hours of rest per hour worked at night"
msgstr "horas de descanso por hora trabajada de noche"

#: apps/tenants/rules.py:370
msgid "Only used when night work is made up with rest."
msgstr "Solo se usa cuando el trabajo nocturno se compensa con descanso."

