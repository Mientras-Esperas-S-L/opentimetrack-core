#, python-format
msgid ""
"Hello %(user.first_name)s,\n"
"\n"
"An account has been created for you at %(company)s to record your working "
"time."
msgstr "Hola %(user.first_name)s:\n\nSe te ha creado una cuenta en %(company)s para registrar tu jornada."

#, python-format
msgid ""
"Hello %(user.first_name)s,\n"
"\n"
"Somebody asked to reset the password of your account at %(company)s."
msgstr "Hola %(user.first_name)s:\n\nAlguien ha pedido restablecer la contraseña de tu cuenta en %(company)s."

msgid "Open this link to set your password:"
msgstr "Abre este enlace para establecer tu contraseña:"

#, python-format
msgid ""
"The link works once and expires in %(hours)s hours.\n"
"\n"
"If it was not you, ignore this message: nothing changes until the link is "
"used."
msgstr "El enlace sirve una sola vez y caduca en %(hours)s horas.\n\nSi no has sido tú, ignora este mensaje: no cambia nada hasta que se use el enlace."

#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"Your working time record has been changed at %(company)s."
msgstr "Hola %(first_name)s:\n\nTu registro de jornada en %(company)s ha cambiado."

#, python-format
msgid ""
"Reason given: %(reason)s\n"
"Decided by: %(resolver)s on %(decided_on)s."
msgstr "Motivo indicado: %(reason)s\nResuelto por: %(resolver)s el %(decided_on)s."

msgid ""
"The previous version has not been deleted: both are kept in your\n"
"history, and you can download your full record at any time.\n"
"\n"
"If this does not match what happened, tell whoever manages your working time."
msgstr "La versión anterior no se ha borrado: las dos quedan en tu\nhistorial, y puedes descargar tu registro completo cuando quieras.\n\nSi esto no coincide con lo que pasó, díselo a quien gestione tu jornada."
