msgstr "Tienes la jornada abierta. Ficha la salida cuando acabes."

#, python-format
msgid ""
"The evidence is too large: %(size)s characters, and the limit is %(max)s."
msgstr ""
"La evidencia ocupa %(size)s caracteres y el límite son %(max)s."

msgid "You clocked a moment ago. Check the screen before clocking again."
msgstr "Acabas de fichar. Mira la pantalla antes de volver a pulsar."

msgid "This person is deactivated and cannot clock in or out."
msgstr "Esta persona está dada de baja y no puede fichar."

msgid "The working day has to be open first."
msgstr "La jornada tiene que estar abierta antes."

#, python-format
msgid "%(basis)s: workers under eighteen may not work overtime."
msgstr ""
"%(basis)s: los menores de dieciocho años no pueden hacer horas "
"extraordinarias."

msgid ""
"Art. 12.4.c ET: part-time work admits no overtime, only complementary hours "
"--- except hours to prevent or repair urgent damage."
msgstr ""
"Art. 12.4.c ET: a tiempo parcial no caben horas extraordinarias, solo "
"complementarias, salvo las de fuerza mayor para prevenir o reparar daños "
"urgentes."

msgid "You cannot clock in: you have approved leave for today."
msgstr "No puedes fichar: tienes una ausencia aprobada para hoy."

