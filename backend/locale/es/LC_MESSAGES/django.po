msgstr "Se ha añadido un fichaje: %(kind)s a las %(when)s."

#, python-format
msgid "The time of an entry was changed to %(when)s."
msgstr "Se ha cambiado la hora de un fichaje a las %(when)s."

#, python-format
msgid "An entry recorded at %(when)s was voided."
msgstr "Se ha anulado el fichaje registrado a las %(when)s."

msgid "Your working time record has changed"
msgstr "Tu registro de jornada ha cambiado"

msgid "The reference matches more than one person."
msgstr "La referencia coincide con más de una persona."

msgid "No active person matches that reference."
msgstr "Ninguna persona activa coincide con esa referencia."

