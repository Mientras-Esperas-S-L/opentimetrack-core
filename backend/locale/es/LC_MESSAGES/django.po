#: templates/emails/account_link.txt:1
#, python-format
msgid ""
"Hello %(user.first_name)s,\n"
"\n"
"An account has been created for you at %(company)s to record your working "
"time."
msgstr ""
"Hola %(user.first_name)s:\n"
"\n"
"Se te ha creado una cuenta en %(company)s para registrar tu jornada."

#: templates/emails/account_link.txt:4
#, python-format
msgid ""
"Hello %(user.first_name)s,\n"
"\n"
"Somebody asked to reset the password of your account at %(company)s."
msgstr ""
"Hola %(user.first_name)s:\n"
"\n"
"Alguien ha pedido restablecer la contraseña de tu cuenta en %(company)s."

#: templates/emails/account_link.txt:8
msgid "Open this link to set your password:"
msgstr "Abre este enlace para establecer tu contraseña:"

#: templates/emails/account_link.txt:12
#, python-format
msgid ""
"The link works once and expires in %(hours)s hours.\n"
"\n"
"If it was not you, ignore this message: nothing changes until the link is "
"used."
msgstr ""
"El enlace sirve una sola vez y caduca en %(hours)s horas.\n"
"\n"
"Si no has sido tú, ignora este mensaje: no cambia nada hasta que se use el "
"enlace."

#: templates/emails/record_change_proposed.txt:1
#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"Your employer, %(company)s, proposes a change to your working time record."
msgstr ""
"Hola %(first_name)s:\n"
"\n"
"Tu empresa, %(company)s, propone un cambio en tu registro de jornada."

#: templates/emails/record_change_proposed.txt:7
#, python-format
msgid ""
"Reason given: %(reason)s\n"
"Proposed by: %(proposed_by)s"
msgstr ""
"Motivo indicado: %(reason)s\n"
"Lo propone: %(proposed_by)s"

#: templates/emails/record_change_proposed.txt:10
#, python-format
msgid ""
"Nothing has changed yet. You can accept it, or say you do not agree ---\n"
"in which case your account is recorded beside the change and the workers' "
"legal\n"
"representation is informed.\n"
"\n"
"You have %(days)s days to answer. After that the company may apply the "
"change,\n"
"and it will be recorded as made without your agreement."
msgstr ""
"Todavía no se ha cambiado nada. Puedes aceptarlo o decir que no estás de\n"
"acuerdo, y en ese caso tu versión queda registrada junto al cambio y se "
"informa\n"
"a la representación legal de las personas trabajadoras.\n"
"\n"
"Tienes %(days)s días para responder. Pasado ese plazo la empresa puede "
"aplicar\n"
"el cambio, y quedará anotado que se hizo sin tu conformidad."

#: templates/emails/record_changed.txt:1
#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"Your working time record has been changed at %(company)s."
msgstr ""
"Hola %(first_name)s:\n"
"\n"
"Tu registro de jornada en %(company)s ha cambiado."

#: templates/emails/record_changed.txt:7
#, python-format
msgid ""
"Reason given: %(reason)s\n"
"Decided by: %(resolver)s on %(decided_on)s."
msgstr ""
"Motivo indicado: %(reason)s\n"
"Resuelto por: %(resolver)s el %(decided_on)s."

#: templates/emails/record_changed.txt:10
msgid ""
"The previous version has not been deleted: both are kept in your\n"
"history, and you can download your full record at any time.\n"
"\n"
"If this does not match what happened, tell whoever manages your working time."
msgstr ""
"La versión anterior no se ha borrado: las dos quedan en tu\n"
"historial, y puedes descargar tu registro completo cuando quieras.\n"
"\n"
"Si esto no coincide con lo que pasó, díselo a quien gestione tu jornada."
