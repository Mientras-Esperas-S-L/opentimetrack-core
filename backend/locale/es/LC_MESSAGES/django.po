msgid "from this day, inclusive"
msgstr "desde este día, incluido"

msgid "to this day, inclusive"
msgstr "hasta este día, incluido"

#, python-format
msgid ""
"You cannot resolve %(what)s of your own. Another manager or administrator "
"has to, so that the change passes through a second person."
msgstr ""
"No puedes resolver %(what)s cuando la persona afectada eres tú. Tiene que "
"hacerlo otro responsable o administrador, para que el cambio pase por una "
"segunda persona."

msgid "created at"
msgstr "creado el"

msgid "updated at"
msgstr "actualizado el"

msgid "A valid session is required."
msgstr "Hace falta una sesión válida."

msgid "Only an administrator may perform this operation."
msgstr "Solo un administrador puede hacer esta operación."

msgid "Manager or administrator profile required."
msgstr "Hace falta perfil de responsable o de administración."

msgid "Only an administrator may modify this resource."
msgstr "Solo un administrador puede modificar este recurso."

msgid "The application does not carry the required permission."
msgstr "La aplicación no tiene el permiso necesario."

