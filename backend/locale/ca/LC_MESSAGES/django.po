# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/serializers.py:449
msgid "Art. 3.b asks for the agreed hours on this regime."
msgstr "L'art. 3.b demana les hores pactades en aquest règim."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/serializers.py:458
msgid "It has to be above zero."
msgstr "Ha de ser més gran que zero."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/serializers.py:478
#, python-format
msgid ""
"%(basis)s: workers under eighteen may not work at night, so the status "
"cannot apply to them."
msgstr ""
"%(basis)s: les persones menors de divuit anys no poden treballar de nit, "
"així que la condició no se'ls pot aplicar."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/serializers.py:497
#, python-format
msgid ""
"%(hours)s h a week is above the company's %(ceiling)s h. A contract cannot "
"agree past the legal maximum."
msgstr ""
"%(hours)s h a la setmana són més que les %(ceiling)s h de l'empresa. Un "
"contracte no pot pactar més enllà del màxim legal."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/serializers.py:546
msgid "A company with this tax number already exists."
msgstr "Ja existeix una empresa amb aquest NIF."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/serializers.py:610 apps/users/serializers.py:623
msgid "Wrong credentials."
msgstr "Credencials incorrectes."

# revisar: traducido sin hablante nativo el 2026-08-28
#: apps/users/serializers.py:689
msgid "Periods of activity are for permanent-seasonal contracts (art. 16 ET)."
msgstr ""
"Els períodes d'activitat són per a contractes fixos discontinus (art. 16 ET)."

# revisar: traducido sin hablante nativo el 2026-08-28
#: apps/users/serializers.py:708
msgid "The season cannot end before it starts."
msgstr "La temporada no pot acabar abans de començar."

# revisar: traducido sin hablante nativo el 2026-08-28
#: apps/users/serializers.py:715
msgid "The call-up comes before the season starts, not after."
msgstr "La crida va abans que comenci la temporada, no després."

# revisar: traducido sin hablante nativo el 2026-08-28
#: apps/users/serializers.py:728
#, python-format
msgid "It overlaps the period that starts on %(day)s."
msgstr "Se superposa amb el període que comença el %(day)s."

#: apps/users/views.py:203
msgid "No session to renew."
msgstr "No hi ha cap sessió per renovar."

#: apps/users/views.py:232
msgid "The session has expired. Sign in again."
msgstr "La sessió ha caducat. Torna a entrar."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/views.py:255
msgid "Send the refresh token to close the session."
msgstr "Envia el testimoni de refresc per tancar la sessió."

#: apps/users/views.py:448
msgid ""
"This is the only active administrator. Appoint another one first, or the "
"company is left with nobody able to manage it."
msgstr ""
"És l'únic administrador actiu. Nomena'n un altre abans, o l'empresa es queda "
"sense ningú que la pugui gestionar."

#: apps/users/views.py:503
msgid "This account signs in through your identity provider."
msgstr "Aquest compte entra a través del vostre proveïdor d'identitat."

#: apps/users/views.py:505
msgid "Reactivate the account before inviting them."
msgstr "Torna a donar d'alta el compte abans de convidar-lo."

#: apps/users/views.py:531
msgid "There is no address to send it to. Add one first."
msgstr "No hi ha cap adreça on enviar-ho. Afegeix-ne una abans."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/views.py:606
msgid "You cannot erase your own account."
msgstr "No pots esborrar el teu propi compte."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/views.py:618
#, python-format
msgid "what is theirs: %(cosas)s"
msgstr "el que és seu: %(cosas)s"

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/views.py:621
#, python-format
msgid "what they decided about other people: %(cosas)s"
msgstr "el que va decidir sobre altres persones: %(cosas)s"

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/views.py:627
#, python-format
msgid ""
"%(quien)s left a record, so their file has to stay and explain it --- "
"%(que)s. Deactivate them instead."
msgstr ""
"%(quien)s va deixar rastre, així que la seva fitxa s'ha de quedar i explicar-"
"ho --- %(que)s. Dóna-li de baixa en comptes d'això."

#: apps/users/views.py:669
msgid "You cannot deactivate your own account."
msgstr "No pots donar de baixa el teu propi compte."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/views.py:725
#, python-format
msgid "Left on %(day)s. %(count)s shift(s) still rostered after that."
msgstr ""
"Va marxar el %(day)s. Encara té %(count)s torn(s) planificats després "
"d'aquesta data."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/views.py:728
#, python-format
msgid "Left on %(day)s."
msgstr "Va marxar el %(day)s."

# revisar: traducido sin hablante nativo el 2026-08-27
#: apps/users/views.py:784
#, python-format
msgid ""
"%(count)s people answer for this department. Move them first: leaving them "
"in charge of nothing means they can no longer read anybody's record but "
"their own."
msgstr ""
"%(count)s persones responen d'aquest departament. Mou-les primer: deixar-les "
"al capdavant de res vol dir que ja no podran llegir el registre de ningú "
"tret del seu."

#: apps/users/views.py:832
#, python-format
msgid ""
"%(count)s people work there. Move them first: without a workplace they lose "
"their local holidays and their time zone."
msgstr ""
"Allà hi treballen %(count)s persones. Mou-les primer: sense centre perden "
"els seus festius locals i la seva zona horària."

#: apps/users/views.py:887
msgid "The link is not valid or has already been used."
msgstr "L'enllaç no és vàlid o ja s'ha fet servir."

# revisar: traducido sin hablante nativo el 2026-08-27
#: config/settings/base.py:329
msgid "Spanish"
msgstr "Castellà"

# revisar: traducido sin hablante nativo el 2026-08-27
#: config/settings/base.py:330
