#: templates/emails/account_link.txt:1
#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"An account has been created for you at %(company)s to record your working "
"time."
msgstr ""
"Hola %(first_name)s:\n"
"\n"
"S'ha creat un compte per a tu a %(company)s per registrar la teva jornada."

#: templates/emails/account_link.txt:4
#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"Somebody asked to reset the password of your account at %(company)s."
msgstr ""
"Hola %(first_name)s:\n"
"\n"
"Algú ha demanat restablir la contrasenya del teu compte a %(company)s."

#: templates/emails/account_link.txt:8
msgid "Open this link to set your password:"
msgstr ""

#: templates/emails/account_link.txt:12
#, python-format
msgid ""
"The link works once and expires in %(hours)s hours.\n"
"\n"
"If it was not you, ignore this message: nothing changes until the link is "
"used."
msgstr ""

#: templates/emails/punch_reminder.txt:1
#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"You have a shift at %(company)s today and have not clocked in yet.\n"
"\n"
"Clock in when you can, so your working day is recorded at the real time."
msgstr ""

#: templates/emails/punch_reminder.txt:5
#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"Your working day of %(day)s at %(company)s is still open: you clocked in and "
"not out.\n"
"\n"
"Clock out when you finish. The server sets the time from your punch, so it "
"is\n"
"recorded exactly as it happens, overtime included if you stay longer today."
msgstr ""

#: templates/emails/punch_reminder.txt:12
msgid ""
"This is only a reminder: nothing has been recorded for you. You can turn "
"these off in your profile."
msgstr ""

#: templates/emails/record_change_proposed.txt:1
#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"Your employer, %(company)s, proposes a change to your working time record."
msgstr ""

#: templates/emails/record_change_proposed.txt:7
#, python-format
msgid ""
"Reason given: %(reason)s\n"
"Proposed by: %(proposed_by)s"
msgstr ""

#: templates/emails/record_change_proposed.txt:10
#, python-format
msgid ""
"Nothing has changed yet. You can accept it, or say you do not agree ---\n"
"in which case your account is recorded beside the change and the workers' "
"legal\n"
"representation is informed.\n"
"\n"
"You have %(days)s days to answer. After that the company may apply the "
"change,\n"
"and it will be recorded as made without your agreement."
msgstr ""

#: templates/emails/record_change_withdrawn.txt:1
#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"Your employer, %(company)s, has withdrawn the change it proposed to your\n"
"working time record."
msgstr ""

#: templates/emails/record_change_withdrawn.txt:8
#, python-format
msgid "Withdrawn by: %(withdrawn_by)s"
msgstr ""

#: templates/emails/record_change_withdrawn.txt:9
#, python-format
msgid "Reason given: %(note)s"
msgstr ""

#: templates/emails/record_change_withdrawn.txt:11
msgid ""
"Your record has not changed, and there is nothing for you to\n"
"answer any more. The entry stayed exactly as it was."
msgstr ""

#: templates/emails/record_changed.txt:1
#, python-format
msgid ""
"Hello %(first_name)s,\n"
"\n"
"Your working time record has been changed at %(company)s."
msgstr ""

#: templates/emails/record_changed.txt:7
#, python-format
msgid ""
"Reason given: %(reason)s\n"
"Decided by: %(resolver)s on %(decided_on)s."
msgstr ""

#: templates/emails/record_changed.txt:10
msgid ""
"The previous version has not been deleted: both are kept in your\n"
"history, and you can download your full record at any time.\n"
"\n"
"If this does not match what happened, tell whoever manages your working time."
msgstr ""

#: templates/emails/representatives_informed.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"You are recorded as a workers' representative at %(company)s."
msgstr ""

#: templates/emails/representatives_informed.txt:5
#, python-format
msgid ""
"%(employee)s disagrees with a change the company proposes to their\n"
"working time record, dated %(day)s."
msgstr ""

#: templates/emails/representatives_informed.txt:8
msgid ""
"Art. 4.b of the working-time record decree requires that you be informed\n"
"when this happens. The company may still apply the change, and if it does, "
"the\n"
"record will show it was made without agreement, with their account beside "
"it.\n"
"\n"
"What they wrote is not reproduced here. Art. 6.2 grants you access to the\n"
"register, so you can consult the entry and its history in the application."
msgstr ""
