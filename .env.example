# Copiar a .env y ajustar. NUNCA se commitea un .env con valores reales.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Base de datos
DATABASE_URL=postgresql://ott:ott@db:5432/opentimetrack

# Redis
REDIS_URL=redis://redis:6379/0

# Almacenamiento (MinIO en desarrollo, S3 en produccion)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=justificantes

# JWT
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
