# Copiar a .env y ajustar. NUNCA se commitea un .env con valores reales.

# Puertos que se publican en el host.
#
# Están parametrizados para poder levantar esto junto a otra pila en la misma
# máquina. Sin definir nada quedan 8000/3000/5432/6379, como siempre.
#
# Dos cosas cuelgan de estos valores y conviene saberlo: OTT_PORT_API viaja a
# VITE_API_URL, porque el navegador llama a la API por el puerto del host y no
# por el de la red interna; y OTT_PORT_WEB decide el origen que la API acepta,
# más abajo en CORS_ALLOWED_ORIGINS.
# OTT_PORT_API=8000
# OTT_PORT_WEB=3000
# OTT_PORT_DB=5432
# OTT_PORT_REDIS=6379

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Base de datos
DATABASE_URL=postgresql://ott:ott@db:5432/opentimetrack

# Redis
REDIS_URL=redis://redis:6379/0

# Almacenamiento de los justificantes.
#
#   filesystem  un directorio en disco. Por defecto en desarrollo y suficiente
#               para una empresa en un solo servidor.
#   s3          cualquier almacen compatible con S3. Obligatorio en cuanto haya
#               mas de un proceso sirviendo la API: con disco, cada uno veria
#               sus propios ficheros.
#
# Las variables STORAGE_* de abajo solo se usan con s3. Para probarlo en
# desarrollo: podman compose --profile s3 up -d
STORAGE_BACKEND=filesystem
# Solo con filesystem, y en produccion tiene que ser un volumen montado:
# STORAGE_PATH=/var/lib/opentimetrack/media
STORAGE_ENDPOINT=http://storage:8333
STORAGE_ACCESS_KEY=ott-dev-access
STORAGE_SECRET_KEY=ott-dev-secret
STORAGE_BUCKET=justificantes

# JWT
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# Frontend
#
# Déjalo vacío y se deduce de OTT_PORT_WEB, que es lo que quieres en casi todos
# los casos: si mueves el puerto para no chocar con otro proyecto, esto lo sigue
# solo. Escribirlo a mano aquí y olvidarse de cambiarlo al mover el puerto deja
# la aplicación sin poder entrar, y el aviso que sale ---«No hay conexión con el
# servidor»--- no apunta a esto.
#
# Ponlo solo si el navegador llega por un origen que el puerto no describe: un
# nombre de máquina, un proxy delante, https.
# CORS_ALLOWED_ORIGINS=https://fichaje.miempresa.example
